{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Node16 rather than plain CommonJS so the exports map in @smto/contracts is
    // respected. This package has no "type" field, so Node16 still emits CommonJS,
    // which is what Nest's decorator metadata needs.
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2023",
    "lib": ["ES2023"],
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": false,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
