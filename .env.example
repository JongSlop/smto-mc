# One .env at the repo root, read by docker compose, the Nest backend, the
# SvelteKit server and the Prisma CLI. Copy to .env and fill in.

# --- database ---------------------------------------------------------------

POSTGRES_USER=smto
# Whatever you put here, put it in DATABASE_URL below as well. They are two
# independent strings, and setting only this one is the most common way to end
# up with a backend that will not start.
POSTGRES_PASSWORD=
POSTGRES_DB=smto_mc_link
# Loopback-mapped port. Not 5432 and not 5433: this host already runs the
# account system's database on 5433, and all three have to coexist.
POSTGRES_PORT=5434

# Used by a developer running the backend directly against the mapped port. The
# compose file overrides it for the container, which reaches postgres by service
# name over the compose network, so a wrong value here only ever bites a local
# run.
#
# The password has to be the same POSTGRES_PASSWORD as above, written out again:
# this is one opaque string to everything that reads it, and nothing expands a
# variable inside it. Leaving the slot empty is the easy mistake, and Postgres
# runs scram-sha-256, so an empty password is a malformed credential rather
# than "no password". The backend refuses to start and says:
#
#   SASL: SCRAM-SERVER-FIRST-MESSAGE: client password must be a string
#
# If you see that, this line is why.
DATABASE_URL=postgresql://smto:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5434/smto_mc_link

# --- addresses --------------------------------------------------------------

# Public address including the subpath. Every redirect URI is built from this,
# and the two identity providers match them exactly, so it has to be right.
#   production: https://smto.dev/mc/link
#   local:      http://localhost:3010/mc/link
PUBLIC_ORIGIN=https://smto.dev/mc/link

# Domain only. What SvelteKit uses for absolute URLs and form-post origin checks.
ORIGIN=https://smto.dev

# --- smto.dev account system ------------------------------------------------

# Endpoints are read from ${OIDC_ISSUER}/.well-known/openid-configuration at
# boot, so only the issuer is configured here.
OIDC_ISSUER=https://smto.dev/account/oauth

# Register this client at https://smto.dev/account/admin/oauth-clients:
#   confidential, client_secret_basic, PKCE S256 required
#   grants: authorization_code, refresh_token
#   scopes: openid profile email roles offline_access
#   redirect URI:            ${PUBLIC_ORIGIN}/auth/callback
OIDC_CLIENT_ID=smto-mc-link
OIDC_CLIENT_SECRET=

# Where the account system sends the browser once it has ended its own session.
# Register the identical string in the client's post-logout redirect URIs over
# there first, or the logout fails with "post_logout_redirect_uri not
# registered". Empty is fine and is the right setting until that registration
# exists: logging out then ends the session here and revokes our refresh token,
# and leaves their single sign-on cookie alone.
OIDC_POST_LOGOUT_REDIRECT_URI=https://smto.dev/mc/link/

# --- Microsoft, for the MSA linking path ------------------------------------

# The launcher's Azure application, reused rather than registered fresh: the
# Minecraft API permission is granted per application and takes months to
# obtain. Add a *Web* platform to that registration with the redirect URI
# ${PUBLIC_ORIGIN}/link/msa/callback, alongside the launcher's existing loopback
# public client, and put its secret below.
MSA_CLIENT_ID=d28a75f9-769f-4bd1-aa82-9791e38c6f67

# Leaving this empty switches the Microsoft path off and the website offers only
# the in-game code. That is a supported way to run this service.
MSA_CLIENT_SECRET=

# --- other smto.dev services players are handed over to ----------------------

# Where the launcher is downloaded, shown in the Services menu. This is also
# the default, so it only needs changing to point somewhere else, or emptying
# to drop the entry.
LAUNCHER_URL=https://smto.dev/launcher/

# The uploader's own origin, no trailing slash. Empty takes the entry out of
# the Services menu in the header, which is a supported way to run: nothing
# else here depends on it.
UPLOADER_BASE_URL=

# The uploader's shared API key, the same one its Minecraft commands use.
#
# It mints a signed-in session for ANY player it is asked about, so treat it
# the way you treat a root password: it never leaves the backend, it is never
# sent to a browser, and if it leaks you rotate it there and here together.
UPLOADER_API_KEY=

# --- secrets ----------------------------------------------------------------

# 32 bytes, base64. Encrypts the account system's refresh tokens at rest.
#   openssl rand -base64 32
SESSION_ENC_KEY=

# --- tuning -----------------------------------------------------------------

SESSION_TTL_DAYS=14
# How quickly a role change at the account system takes effect here.
ROLE_REFRESH_MINUTES=15
LINK_CODE_TTL_MINUTES=10
SKIN_CACHE_TTL_HOURS=6
